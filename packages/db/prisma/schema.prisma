generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String            @id @default(cuid())
  email               String            @unique
  name                String?
}

enum ReleaseStatus {
  RELEASED
  UPCOMING
  CANCELLED
}

model Movie {
  id                  String            @id @default(cuid())
  name                String
  description         String
  casts               String[]
  trailerUrl          String
  language            String            @default("English")
  releaseDate         DateTime
  director            String
  releaseStatus       ReleaseStatus     @default(RELEASED)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt   
}