generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//
// =========================
// USER
// =========================
//

model User {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?
}

//
// =========================
// MOVIE
// =========================
//

enum ReleaseStatus {
  RELEASED
  UPCOMING
  CANCELLED
}

model Movie {
  id              String          @id @default(cuid())

  name            String
  description     String
  casts           String[]
  trailerUrl      String
  language        String          @default("English")
  releaseDate     DateTime
  director        String
  releaseStatus   ReleaseStatus   @default(RELEASED)

  theaterMovies   TheaterMovie[]
  showtimes       Showtime[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

//
// =========================
// THEATER
// =========================
//

model Theater {
  id              String          @id @default(cuid())

  name            String
  description     String?
  city            String
  address         String
  state           String?
  pincode         String?

  latitude        Float?
  longitude       Float?

  totalScreens    Int             @default(1)
  amenities       String[]        // ["Parking", "Food Court", "Wheelchair Access"]
  isActive        Boolean         @default(true)

  theaterMovies   TheaterMovie[]
  screens         Screen[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

//
// =========================
// THEATER MOVIE (Junction)
// =========================
//

model TheaterMovie {
  id              String          @id @default(cuid())

  theaterId       String
  theater         Theater         @relation(fields: [theaterId], references: [id], onDelete: Cascade)

  movieId         String
  movie           Movie           @relation(fields: [movieId], references: [id], onDelete: Cascade)

  addedAt         DateTime        @default(now())

  @@unique([theaterId, movieId])
}

//
// =========================
// SCREEN
// =========================
//

enum ScreenType {
  STANDARD
  IMAX
  FOUR_DX
  GOLD_CLASS
  RECLINER
}

model Screen {
  id              String          @id @default(cuid())

  name            String
  totalSeats      Int
  screenType      ScreenType      @default(STANDARD)

  theaterId       String
  theater         Theater         @relation(fields: [theaterId], references: [id], onDelete: Cascade)

  showtimes       Showtime[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([theaterId, name]) // Prevent duplicate screen names within a theater
}

//
// =========================
// SHOWTIME
// =========================
//

model Showtime {
  id              String          @id @default(cuid())

  movieId         String
  movie           Movie           @relation(fields: [movieId], references: [id], onDelete: Cascade)

  screenId        String
  screen          Screen          @relation(fields: [screenId], references: [id], onDelete: Cascade)

  startTime       DateTime
  endTime         DateTime
  price           Float

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([movieId])
  @@unique([screenId])
  @@unique([startTime])
  @@unique([screenId, startTime]) // prevents double-booking a screen at the exact same start time
}